# 이 파일을 .env.paper로 복사한 뒤 실제 값을 입력하세요.
# .env.paper는 .gitignore에 포함되어 GitHub에 올라가지 않습니다.

KIS_PAPER_APP_KEY="여기에_모의투자_앱키"
KIS_PAPER_APP_SECRET="여기에_모의투자_앱시크릿"
KIS_PAPER_ACCOUNT_NO="계좌번호_앞8자리"
KIS_PAPER_ACCOUNT_PRODUCT_CODE="01"

# Streamlit Cloud에서 상태를 보려면 아래 두 값을 입력하세요.
# 사용하지 않을 경우 빈 값으로 두어도 됩니다.
FIREBASE_DATABASE_URL=""
FIREBASE_DATABASE_TOKEN=""
